# Copy this file to .env.local and fill in real values.
# For Gmail: enable 2FA on the account, then create an "App Password"
# at https://myaccount.google.com/apppasswords and use it as SMTP_PASS.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-char-app-password

# Optional — where contact-form messages are delivered.
# Defaults to the email in data/data.js if not set.
CONTACT_TO=nikhilpatil3701@gmail.com
